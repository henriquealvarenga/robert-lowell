---
/**
 * Linha do tempo interativa 1917–1977: marcos biográficos e as 11 crises.
 * Cada crise abre um painel (<dialog>) com o relato completo, a imagem e as citações.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import marcos from '../data/marcos.json';
import { href } from '../config';

const crises = (await getCollection('crises')).filter((c) => c.data.tipo !== 'intro').sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(crises.map(async (c) => ({ entry: c, Content: (await render(c)).Content })));
// âncoras reais das seções no capítulo "As Crises"
const crisesChapter = (await getCollection('chapters')).find((c) => c.id === 'crises')!;
const chapterHeadings = (await render(crisesChapter)).headings.filter((h) => h.depth === 2);
const anchorFor = (title: string) => chapterHeadings.find((h) => h.text.trim() === title.trim())?.slug ?? '';

const MESES = ['', 'jan.', 'fev.', 'mar.', 'abr.', 'mai.', 'jun.', 'jul.', 'ago.', 'set.', 'out.', 'nov.', 'dez.'];
type Item =
  | { kind: 'marco'; ano: number; mes: number; id: string; data: string; tipo: string; titulo: string; trecho: string; link?: { href: string; label: string }; ref?: string }
  | { kind: 'crise'; ano: number; mes: number; id: string; data: string; tipo: string; titulo: string; local: string; slug: string; seguidaDe?: string; nota?: string; order: number };

const items: Item[] = [
  ...marcos.map((m: any) => ({ kind: 'marco' as const, ano: m.ano, mes: m.mes ?? 0, id: m.id, data: m.data, tipo: m.tipo, titulo: m.titulo, trecho: m.trecho, link: m.link, ref: m.ref })),
  ...crises.map((c) => ({
    kind: 'crise' as const,
    ano: c.data.ano,
    mes: c.data.mes,
    id: `crise-${c.data.slug}`,
    data: `${MESES[c.data.mes]} ${c.data.ano}`,
    tipo: c.data.tipo,
    titulo: c.data.title,
    local: c.data.local,
    slug: c.data.slug,
    seguidaDe: c.data.seguidaDe,
    nota: c.data.nota,
    order: c.data.order,
  })),
].sort((a, b) => a.ano - b.ano || a.mes - b.mes || (a.kind === 'crise' ? 1 : -1));

const tagLabel: Record<string, string> = { mania: 'Mania', depressao: 'Depressão', marco: 'Marco', litio: 'Lítio', intoxicacao: 'Intoxicação por lítio', morte: 'Morte' };
const tagClass: Record<string, string> = { mania: 'tag-mania', depressao: 'tag-depressao', marco: 'tag-marco', litio: 'tag-litio', intoxicacao: 'tag-litio', morte: 'tag-neutro' };
const decades = [1917, 1949, 1957, 1967, 1977];
---

<section class="timeline wrap" id="linha-do-tempo" aria-labelledby="tl-titulo" data-timeline data-total-crises={crises.length}>
  <header class="tl-head">
    <p class="eyebrow">Linha do tempo · 1917–1977</p>
    <h2 id="tl-titulo">Sessenta anos, onze crises descritas</h2>
    <p class="tl-sub ui">Role para percorrer. Os marcos biográficos aparecem em dourado e azul; as crises, em vermelho (mania) ou cinza (depressão). Toque em uma crise para abrir o relato completo.</p>
    <p class="tl-count ui" data-tl-count aria-live="polite"></p>
  </header>

  <ol class="tl-list">
    <li class="tl-spine" aria-hidden="true"><span data-spine></span></li>
    {items.map((it, i) => (
      <li class:list={['tl-item', `tl-${it.kind}`, `tl-tipo-${it.tipo}`]} data-ano={it.ano} data-tl-item>
        <span class="tl-dot" aria-hidden="true"></span>
        <div class="tl-card card">
          <div class="tl-meta">
            <span class={`tag ${tagClass[it.tipo]}`}>{tagLabel[it.tipo]}</span>
            {it.kind === 'crise' && it.seguidaDe && <span class="tag tag-depressao">seguida de depressão</span>}
            {it.kind === 'crise' && it.nota && <span class="tag tag-neutro">{it.nota}</span>}
            <time class="tl-date ui" datetime={`${it.ano}${it.mes ? `-${String(it.mes).padStart(2, '0')}` : ''}`}>{it.data}</time>
          </div>
          {it.kind === 'crise' ? (
            <>
              <h3 class="tl-title">{it.titulo}</h3>
              <p class="tl-place ui">Crise {it.order} de {crises.length} · {it.local}</p>
              <button type="button" class="btn btn-sm" data-open-crisis={it.slug} aria-haspopup="dialog">Abrir o relato</button>
            </>
          ) : (
            <>
              <h3 class="tl-title">{it.titulo}</h3>
              <p class="tl-trecho">“{it.trecho.replace(/\*/g, '')}”</p>
              {(it.link || it.ref) && (
                <p class="tl-links ui">
                  {it.link && <a href={it.link.href} target="_blank" rel="noopener">{it.link.label}</a>}
                  {it.ref && <a href={href(`/capitulos/referencias/#ref-${it.ref}`)}>Ver nas referências</a>}
                </p>
              )}
            </>
          )}
        </div>
      </li>
    ))}
  </ol>

  {rendered.map(({ entry, Content }, i) => (
    <dialog class="crisis-dialog" id={`dialog-${entry.data.slug}`} data-crisis={entry.data.slug} aria-labelledby={`dialog-${entry.data.slug}-t`}>
      <div class="crisis-inner">
        <header class="crisis-head">
          <div class="tl-meta">
            <span class={`tag ${tagClass[entry.data.tipo]}`}>{tagLabel[entry.data.tipo]}</span>
            {entry.data.seguidaDe && <span class="tag tag-depressao">seguida de depressão</span>}
            {entry.data.nota && <span class="tag tag-neutro">{entry.data.nota}</span>}
            <span class="ui crisis-n">Crise {entry.data.order} de {crises.length}</span>
          </div>
          <h2 id={`dialog-${entry.data.slug}-t`}>{entry.data.title}</h2>
          <button type="button" class="icon-btn crisis-close" data-close aria-label="Fechar">✕</button>
        </header>
        <div class="crisis-body prose">
          {entry.data.extraImage && (
            <figure class="ilustracao">
              <Image src={entry.data.extraImage} alt="" widths={[640, 960, 1280]} sizes="(min-width: 760px) 44rem, 100vw" />
              <figcaption><span class="ai-badge">Ilustração gerada por IA (Google Gemini)</span></figcaption>
            </figure>
          )}
          <Content />
        </div>
        <footer class="crisis-foot">
          <a class="btn btn-sm" href={href(`/capitulos/crises/#${anchorFor(entry.data.title)}`)}>Ler no capítulo</a>
          <div class="crisis-nav">
            {i > 0 && <button type="button" class="btn btn-sm" data-open-crisis={rendered[i - 1].entry.data.slug}>← Crise anterior</button>}
            {i < rendered.length - 1 && <button type="button" class="btn btn-sm" data-open-crisis={rendered[i + 1].entry.data.slug}>Próxima crise →</button>}
          </div>
        </footer>
      </div>
    </dialog>
  ))}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { markCrisisSeen, snapshot } from '../lib/progress';

  const root = document.querySelector<HTMLElement>('[data-timeline]');
  if (root) {
    const total = Number(root.dataset.totalCrises);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-tl-item]'));

    // contador de crises visitadas
    const count = root.querySelector<HTMLElement>('[data-tl-count]')!;
    const updateCount = () => {
      const n = snapshot().crisesVistas.length;
      count.textContent = n ? `Você já abriu ${n} de ${total} crises.` : '';
      root.querySelectorAll<HTMLButtonElement>('[data-open-crisis]').forEach((b) => {
        if (snapshot().crisesVistas.includes(b.dataset.openCrisis!)) b.closest('.tl-item')?.classList.add('is-seen');
      });
    };
    updateCount();
    window.addEventListener('jornada:progress', updateCount);

    // painéis
    let lastTrigger: HTMLElement | null = null;
    const open = (slug: string, trigger?: HTMLElement) => {
      const dlg = root.querySelector<HTMLDialogElement>(`[data-crisis="${slug}"]`);
      if (!dlg) return;
      root.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
      if (trigger) lastTrigger = trigger;
      dlg.showModal();
      dlg.querySelector<HTMLElement>('.crisis-inner')!.scrollTop = 0;
      markCrisisSeen(slug, total);
      history.replaceState(null, '', `#crise-${slug}`);
    };
    root.querySelectorAll<HTMLButtonElement>('[data-open-crisis]').forEach((b) => b.addEventListener('click', () => open(b.dataset.openCrisis!, b)));
    root.querySelectorAll<HTMLDialogElement>('dialog').forEach((dlg) => {
      dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
      dlg.addEventListener('close', () => {
        if (location.hash.startsWith('#crise-')) history.replaceState(null, '', location.pathname + location.search);
        lastTrigger?.focus();
      });
    });
    if (location.hash.startsWith('#crise-')) {
      const slug = location.hash.slice('#crise-'.length);
      const btn = root.querySelector<HTMLButtonElement>(`[data-open-crisis="${slug}"]`);
      btn?.scrollIntoView({ block: 'center' });
      setTimeout(() => open(slug, btn ?? undefined), 300);
    }

    // animação de rolagem
    if (!reduce) {
      gsap.registerPlugin(ScrollTrigger);
      const spine = root.querySelector('[data-spine]');
      const list = root.querySelector('.tl-list')!;
      gsap.fromTo(
        spine,
        { scaleY: 0 },
        { scaleY: 1, ease: 'none', scrollTrigger: { trigger: list, start: 'top 70%', end: 'bottom 70%', scrub: 0.4 } },
      );
      items.forEach((it) => {
        gsap.fromTo(
          it.querySelector('.tl-card'),
          { autoAlpha: 0, y: 28 },
          { autoAlpha: 1, y: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: { trigger: it, start: 'top 85%', once: true } },
        );
        gsap.fromTo(
          it.querySelector('.tl-dot'),
          { scale: 0 },
          { scale: 1, duration: 0.4, ease: 'back.out(2)', scrollTrigger: { trigger: it, start: 'top 80%', once: true } },
        );
      });
    } else {
      items.forEach((it) => it.classList.add('is-static'));
    }
  }
</script>

<style>
  .timeline {
    padding: 3rem 0 1rem;
  }
  .tl-head {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .tl-head h2 {
    margin: 0.4rem 0 0.75rem;
  }
  .tl-sub {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .tl-count {
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 1.2em;
  }
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 2rem;
    position: relative;
    display: grid;
    gap: 1.5rem;
  }
  .tl-spine {
    position: absolute;
    left: 0.6rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .tl-spine span {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--red), var(--blue));
    transform-origin: top;
  }
  .tl-item {
    position: relative;
  }
  .tl-dot {
    position: absolute;
    left: calc(-2rem + 0.6rem - 0.45rem + 1px);
    top: 1.1rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 2px var(--gold);
  }
  .tl-tipo-mania .tl-dot {
    background: var(--red);
    box-shadow: 0 0 0 2px var(--red);
  }
  .tl-tipo-depressao .tl-dot {
    background: var(--slate);
    box-shadow: 0 0 0 2px var(--slate);
  }
  .tl-tipo-litio .tl-dot,
  .tl-tipo-intoxicacao .tl-dot {
    background: var(--blue);
    box-shadow: 0 0 0 2px var(--blue);
  }
  .tl-tipo-morte .tl-dot {
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--ink);
  }
  .tl-card {
    padding: 1rem 1.2rem;
    display: grid;
    gap: 0.4rem;
  }
  .tl-crise .tl-card {
    border-left: 4px solid var(--red);
  }
  .tl-tipo-depressao .tl-card {
    border-left-color: var(--slate);
  }
  .tl-item.is-seen .tl-card::after {
    content: '✓ visitada';
    font-family: var(--font-ui);
    font-size: 0.72rem;
    color: var(--gold);
    font-weight: 600;
  }
  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
  }
  .tl-date {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .tl-title {
    font-size: 1.2rem;
  }
  .tl-place {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }
  .tl-trecho {
    margin: 0;
    font-size: 0.95em;
    color: var(--ink-2);
    font-style: italic;
  }
  .tl-links {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .tl-card .btn {
    justify-self: start;
    margin-top: 0.3rem;
  }
  @media (min-width: 800px) {
    .tl-list {
      padding: 0;
      gap: 0.5rem;
    }
    .tl-spine {
      left: 50%;
      margin-left: -1px;
    }
    .tl-item {
      width: calc(50% - 2.5rem);
    }
    .tl-item:nth-child(even) {
      margin-left: auto;
    }
    .tl-item:nth-child(even) .tl-dot {
      left: calc(-2.5rem - 0.45rem + 1px);
    }
    .tl-item:nth-child(odd) .tl-dot {
      left: auto;
      right: calc(-2.5rem - 0.45rem + 1px);
    }
  }

  /* painel da crise */
  .crisis-dialog {
    border: 0;
    padding: 0;
    width: min(100% - 1rem, 46rem);
    max-height: min(92dvh, 60rem);
    background: var(--bg-elev);
    color: var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .crisis-dialog::backdrop {
    background: rgb(20 18 15 / 0.55);
    backdrop-filter: blur(3px);
  }
  .crisis-inner {
    max-height: min(92dvh, 60rem);
    overflow: auto;
    padding: 1.5rem clamp(1rem, 4vw, 2.5rem) 1.5rem;
  }
  .crisis-head {
    position: relative;
    padding-right: 3rem;
    margin-bottom: 1rem;
  }
  .crisis-head h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }
  .crisis-n {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .crisis-close {
    position: absolute;
    right: 0;
    top: 0;
  }
  .crisis-body :global(figure.ilustracao) {
    margin: 0 0 1.5rem;
  }
  .crisis-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .crisis-nav {
    display: flex;
    gap: 0.5rem;
  }
</style>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HospitalChart from '../../components/HospitalChart.astro';
import FamilyTree from '../../components/FamilyTree.astro';
import ChapterNav from '../../components/ChapterNav.astro';
import { href } from '../../config';

export async function getStaticPaths() {
  const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
  return chapters.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: chapters[i - 1] ?? null, next: chapters[i + 1] ?? null, all: chapters },
  }));
}

const { entry, prev, next, all } = Astro.props;
const { Content, headings } = await render(entry);
const h2s = headings.filter((h) => h.depth === 2);
const number = entry.data.order;
const total = all.length;
const path = `/capitulos/${entry.id}/`;
const desc = `${entry.data.title} — capítulo ${number + 1} de ${total} de “A Jornada de Lowell”, sobre a história do transtorno bipolar do poeta Robert Lowell.`;
---

<Base title={entry.data.title} description={desc} path={path} type="article">
  <article class="chapter" data-chapter={entry.id} data-achievement={entry.data.achievement}>
    <header class="chapter-head wrap">
      <p class="eyebrow">Capítulo {number + 1} de {total} · {entry.data.minutes} min de leitura</p>
      <h1>{entry.data.title}</h1>
      <ChapterNav all={all} current={entry.id} compact />
    </header>

    <div class="chapter-grid wrap">
      <aside class="chapter-aside">
        <nav class="toc card" aria-label="Índice">
          <p class="eyebrow">Nesta jornada</p>
          <ol class="toc-chapters">
            {all.map((c) => (
              <li class={c.id === entry.id ? 'is-current' : ''}>
                <a href={href(`/capitulos/${c.id}/`)} aria-current={c.id === entry.id ? 'page' : undefined}>
                  <span class="toc-num">{c.data.order + 1}</span> {c.data.nav}
                </a>
              </li>
            ))}
            <li><a href={href('/capitulos/referencias/')}><span class="toc-num">{total + 1}</span> Referências</a></li>
          </ol>
          {h2s.length > 0 && (
            <>
              <p class="eyebrow">Neste capítulo</p>
              <ol class="toc-sections" data-toc>
                {h2s.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </>
          )}
        </nav>
        <div class="read-progress" aria-hidden="true"><span data-read-bar></span></div>
      </aside>

      <div class="chapter-body prose">
        {entry.id === 'sobre' && (
          <>
            <aside class="sobre-versao card" aria-labelledby="sobre-versao-t">
              <p class="eyebrow" id="sobre-versao-t">Sobre esta versão</p>
              <p>
                Esta experiência interativa foi criada em 15 de outubro de 2026 a partir do resumo publicado em 2024. O conteúdo é baseado no livro <em>Robert Lowell: Setting the River on Fire</em> (Vintage, 2017), de Kay Redfield Jamison. O site foi construído com apoio da IA Claude Code. As ilustrações são geradas por inteligência artificial (DALL·E) e não são retratos reais.
              </p>
            </aside>
            <p class="eyebrow sobre-original">Texto original (2024)</p>
          </>
        )}
        <Content />
        {entry.data.chartCaption && (
          <div data-chart-source>
            <HospitalChart caption={entry.data.chartCaption} id="grafico-internacoes" />
          </div>
        )}
        {entry.id === 'historia-familiar' && <FamilyTree />}
      </div>
    </div>

    <footer class="chapter-foot wrap">
      <nav class="pager" aria-label="Navegação entre capítulos">
        {prev ? (
          <a class="pager-link prev card" href={href(`/capitulos/${prev.id}/`)} rel="prev">
            <span class="eyebrow">← Anterior</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <a class="pager-link prev card" href={href('/jornada/')}>
            <span class="eyebrow">← Voltar</span>
            <span class="pager-title">A jornada</span>
          </a>
        )}
        {next ? (
          <a class="pager-link next card" href={href(`/capitulos/${next.id}/`)} rel="next">
            <span class="eyebrow">Próximo →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <a class="pager-link next card" href={href('/capitulos/referencias/')} rel="next">
            <span class="eyebrow">Próximo →</span>
            <span class="pager-title">Referências</span>
          </a>
        )}
      </nav>
    </footer>
  </article>

  <script>
    import { unlockOnReadEnd } from '../../lib/progress';
    const article = document.querySelector<HTMLElement>('.chapter')!;
    // gráfico interativo no lugar da imagem estática do livro
    const slot = article.querySelector('.chart-slot');
    const source = article.querySelector('[data-chart-source]');
    if (slot && source) {
      slot.replaceWith(...Array.from(source.childNodes));
      source.remove();
    }
    // conquista ao terminar a leitura
    const id = article.dataset.achievement;
    if (id) unlockOnReadEnd(article.querySelector('.chapter-body')!, id);
    // barra de leitura e destaque do índice
    const bar = article.querySelector<HTMLElement>('[data-read-bar]');
    const body = article.querySelector<HTMLElement>('.chapter-body')!;
    const onScroll = () => {
      if (!bar) return;
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight;
      const k = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${k})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    const toc = article.querySelector('[data-toc]');
    if (toc && 'IntersectionObserver' in window) {
      const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            links.forEach((l) => l.classList.toggle('is-active', l.hash === `#${en.target.id}`));
          });
        },
        { rootMargin: '-20% 0px -70% 0px' },
      );
      links.forEach((l) => {
        const t = document.getElementById(decodeURIComponent(l.hash.slice(1)));
        if (t) io.observe(t);
      });
    }
  </script>

  <style>
    .chapter-head {
      padding: 3rem 0 1.5rem;
    }
    .chapter-head h1 {
      margin: 0.5rem 0 1.25rem;
      max-width: 20ch;
    }
    .chapter-grid {
      display: grid;
      gap: 2rem;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .chapter-grid {
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 3.5rem;
      }
      .chapter-aside {
        position: sticky;
        top: calc(var(--header-h) + 1rem);
      }
      .chapter-body {
        max-width: var(--measure);
      }
    }
    .toc {
      padding: 1rem 1.1rem;
      font-family: var(--font-ui);
      font-size: 0.88rem;
    }
    .toc .eyebrow {
      margin: 0 0 0.5rem;
    }
    .toc .eyebrow + .toc-sections,
    .toc-chapters + .eyebrow {
      margin-top: 1rem;
    }
    .toc ol {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc li a {
      display: flex;
      gap: 0.5rem;
      padding: 0.3rem 0.4rem;
      border-radius: 6px;
      text-decoration: none;
      color: var(--ink-2);
      line-height: 1.35;
    }
    .toc li a:hover {
      background: var(--bg-sunk);
      color: var(--ink);
    }
    .toc li.is-current a,
    .toc-sections a.is-active {
      color: var(--red);
      font-weight: 600;
    }
    .toc-num {
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      min-width: 1.2em;
      font-weight: 500;
    }
    @media (max-width: 1023px) {
      .toc-chapters {
        display: none;
      }
      .toc .eyebrow:first-child {
        display: none;
      }
      .toc-chapters + .eyebrow {
        margin-top: 0;
      }
      .toc:not(:has(.toc-sections)) {
        display: none;
      }
    }
    .read-progress {
      margin-top: 0.75rem;
      height: 3px;
      background: var(--line);
      border-radius: 2px;
      overflow: hidden;
    }
    .read-progress span {
      display: block;
      height: 100%;
      background: var(--red);
      transform-origin: left;
      transform: scaleX(0);
      transition: transform 0.1s linear;
    }
    @media (max-width: 1023px) {
      .read-progress {
        position: fixed;
        top: var(--header-h);
        left: 0;
        right: 0;
        margin: 0;
        border-radius: 0;
        z-index: 49;
        background: transparent;
      }
    }
    .chapter-body :global(> p:first-of-type) {
      font-variation-settings: 'opsz' 20;
    }
    .chapter-body :global(> p:first-of-type::first-letter) {
      font-family: var(--font-display);
      font-size: 3.4em;
      line-height: 0.8;
      float: left;
      padding: 0.1em 0.12em 0 0;
      color: var(--red);
      font-weight: 500;
    }
    .sobre-versao {
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
      border-left: 4px solid var(--red);
    }
    .sobre-versao p:last-child {
      margin: 0.5rem 0 0;
    }
    .sobre-original {
      margin-bottom: 1rem;
    }
    .chapter-foot {
      margin-top: 3rem;
    }
    .pager {
      display: grid;
      gap: 1rem;
    }
    @media (min-width: 640px) {
      .pager {
        grid-template-columns: 1fr 1fr;
      }
    }
    .pager-link {
      padding: 1rem 1.25rem;
      text-decoration: none;
      color: var(--ink);
      display: grid;
      gap: 0.25rem;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .pager-link:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
      color: var(--ink);
    }
    .pager-link.next {
      text-align: right;
    }
    .pager-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
    }
  </style>
</Base>

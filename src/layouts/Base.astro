---
import '../styles/global.css';
import { SITE_URL, OLD_SITE_URL, TITLE, DESCRIPTION, AUTHOR, href, BASE } from '../config';
import ogImage from '../assets/images/capa.webp';
import { getImage } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  /** caminho da página com base, p.ex. "/capitulos/crises/" */
  path: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description = DESCRIPTION, path, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${TITLE}` : `${TITLE} — ${DESCRIPTION.split(':')[0]}`;
const canonical = new URL(path.replace(/^\//, ''), SITE_URL).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src.replace(/^\//, ''), 'https://henriquealvarenga.com/').href;
const current = Astro.url.pathname;
const navItems = [
  { label: 'Jornada', to: href('/jornada/') },
  { label: 'Capítulos', to: href('/capitulos/introducao/') },
  { label: 'Quiz', to: href('/quiz/') },
  { label: 'Caso clínico', to: href('/caso-clinico/') },
];
const isActive = (to: string) => (to.includes('/capitulos/') ? current.includes('/capitulos/') : current === to);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://henriquealvarenga.com/#pessoa',
      name: AUTHOR.name,
      honorificPrefix: 'Dr.',
      jobTitle: 'Médico Psiquiatra e Professor de Medicina',
      url: AUTHOR.url,
      identifier: [
        { '@type': 'PropertyValue', propertyID: 'CRM-MG', value: '31.778' },
        { '@type': 'PropertyValue', propertyID: 'RQE', value: '8381' },
        { '@type': 'PropertyValue', propertyID: 'ORCID', value: '0000-0001-9799-5240' },
      ],
      sameAs: [AUTHOR.orcid],
    },
    {
      '@type': type === 'article' ? 'Article' : 'WebSite',
      '@id': `${SITE_URL}#site`,
      name: TITLE,
      headline: title ?? TITLE,
      description,
      url: canonical,
      inLanguage: 'pt-BR',
      author: { '@id': 'https://henriquealvarenga.com/#pessoa' },
      isAccessibleForFree: true,
      isBasedOn: { '@type': 'Book', name: 'Robert Lowell: Setting the River on Fire', author: 'Kay Redfield Jamison', datePublished: '2017' },
      about: [
        { '@type': 'MedicalCondition', name: 'Transtorno bipolar' },
        { '@type': 'Thing', name: 'Robert Lowell' },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={AUTHOR.display} />
    <meta name="theme-color" content="#f5f1e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${BASE}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={TITLE} />
    <meta property="og:title" content={title ?? TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Tema: aplica a escolha salva antes da primeira pintura (evita piscar).
      try {
        const t = localStorage.getItem('jornada-lowell:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')} aria-label="A Jornada de Lowell — página inicial">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M2 12c2.5 0 2.5-7 5-7s2.5 14 5 14 2.5-14 5-14 2.5 7 5 7" />
          </svg>
          <span>A Jornada de Lowell</span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          {navItems.map((n) => (
            <a class="nav-text" href={n.to} aria-current={isActive(n.to) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
          <button class="icon-btn theme-toggle" type="button" aria-label="Alternar tema claro/escuro" title="Tema">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <h2>Autor</h2>
          <p><strong>{AUTHOR.display}</strong><br />{AUTHOR.role} · {AUTHOR.crm} · {AUTHOR.rqe}</p>
          <p><a href={AUTHOR.url}>henriquealvarenga.com</a></p>
          <p>
            Baseado em Kay Redfield Jamison, <em>Robert Lowell: Setting the River on Fire</em> (Vintage, 2017). Material de ensino para estudantes de psiquiatria e psicologia.
          </p>
        </div>
        <div>
          <h2>Ilustrações</h2>
          <p>As imagens deste site são meramente ilustrativas e foram geradas por inteligência artificial (DALL·E, OpenAI). Não são retratos reais.</p>
        </div>
        <div>
          <h2>Versões</h2>
          <ul>
            <li><a href={OLD_SITE_URL}>Site antigo (versão em livro)</a></li>
            <li><a href={href('/capitulos/referencias/')}>Referências</a></li>
            <li><a href={href('/capitulos/sobre/')}>Sobre</a></li>
            <li><button type="button" class="link-btn" data-reset-progress>Apagar meu progresso</button></li>
          </ul>
        </div>
      </div>
    </footer>

    <div class="toast-region" aria-live="polite" aria-atomic="true"></div>

    <script>
      import { reset, unlock } from '../lib/progress';
      window.addEventListener('jornada:unlock', (e) => unlock((e as CustomEvent).detail as string));
      // tema
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const currentDark = root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark;
        const next = currentDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('jornada-lowell:theme', next);
        } catch {}
      });
      // conquistas: aviso discreto
      const region = document.querySelector('.toast-region')!;
      window.addEventListener('jornada:achievement', (e) => {
        const a = (e as CustomEvent).detail as { title: string; description: string; icon: string };
        const el = document.createElement('div');
        el.className = 'toast';
        el.innerHTML = `<span class="toast-icon" aria-hidden="true">${a.icon}</span><div><strong>Conquista: ${a.title}</strong><br><span>${a.description}</span></div>`;
        region.appendChild(el);
        requestAnimationFrame(() => el.classList.add('show'));
        setTimeout(() => {
          el.classList.remove('show');
          setTimeout(() => el.remove(), 400);
        }, 4500);
      });
      document.querySelector('[data-reset-progress]')?.addEventListener('click', () => {
        reset();
        const el = document.createElement('div');
        el.className = 'toast show';
        el.textContent = 'Progresso apagado.';
        region.appendChild(el);
        setTimeout(() => el.remove(), 2500);
      });
      // revelação suave ao rolar
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) items.forEach((i) => i.classList.add('is-visible'));
      else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((en) => en.isIntersecting && (en.target.classList.add('is-visible'), io.unobserve(en.target))),
          { threshold: 0.12 },
        );
        items.forEach((i) => io.observe(i));
      }
    </script>
    <style is:global>
      .link-btn {
        background: none;
        border: 0;
        padding: 0;
        color: var(--blue-ink);
        text-decoration: underline;
        cursor: pointer;
        font: inherit;
      }
      .link-btn:hover {
        color: var(--red);
      }
      .toast-region {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 90;
        display: grid;
        gap: 0.5rem;
        max-width: min(22rem, calc(100% - 2rem));
      }
      .toast {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        background: var(--ink);
        color: var(--bg);
        padding: 0.8rem 1rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        font-family: var(--font-ui);
        font-size: 0.85rem;
        line-height: 1.4;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.3s, transform 0.3s;
      }
      .toast.show {
        opacity: 1;
        transform: none;
      }
      .toast-icon {
        font-size: 1.3rem;
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--gold);
        color: var(--ink);
        flex: none;
      }
    </style>
  </body>
</html>
